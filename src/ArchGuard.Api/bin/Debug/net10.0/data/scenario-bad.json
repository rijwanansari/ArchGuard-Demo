{
  "name": "Customer Notification Platform",
  "businessCapability": "Customer Communications",
  "environment": "Production",
  "components": [
    {
      "name": "NotificationApi",
      "type": "API",
      "technology": "Azure App Service",
      "properties": {
        "authentication": "None",
        "secretsManagement": "EnvironmentVariables"
      }
    },
    {
      "name": "NotificationWorker",
      "type": "Worker",
      "technology": "Azure Functions",
      "properties": {}
    },
    {
      "name": "MessageBus",
      "type": "Messaging",
      "technology": "Azure Service Bus",
      "properties": {
        "retryPolicy": "",
        "deadLetterQueue": ""
      }
    },
    {
      "name": "CustomerDb",
      "type": "Database",
      "technology": "Azure SQL",
      "properties": {}
    },
    {
      "name": "CustomerAI",
      "type": "AI",
      "technology": "Azure OpenAI",
      "properties": {
        "dataPolicy": "PIIAllowed"
      }
    }
  ],
  "dependencies": [
    {
      "from": "NotificationApi",
      "to": "NotificationWorker",
      "protocol": "HTTP"
    },
    {
      "from": "NotificationWorker",
      "to": "MessageBus",
      "protocol": "ServiceBus"
    }
  ],
  "dataAssets": [
    {
      "name": "CustomerProfile",
      "classification": "Internal",
      "store": "CustomerDb",
      "containsPii": true,
      "residency": "Unknown"
    }
  ],
  "externalSystems": [
    {
      "name": "Azure OpenAI",
      "type": "AI",
      "dataBoundary": "Unknown",
      "approved": false
    }
  ]
}
